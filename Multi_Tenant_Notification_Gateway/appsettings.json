{
  "ConnectionStrings": {
    "NotificationGateway": "Server=(localdb)\\MSSQLLocalDB;Database=NotificationGateway;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "attendance-system",
    "Audience": "notification-gateway",
    "SigningKey": "",
    "EnableDevTokens": false
  },
  "SecretProtection": {
    "ActiveKeyId": "",
    "Keys": {}
  },
  "RabbitMq": {
    "Enabled": true,
    "Uri": "amqp://guest:guest@localhost:5672/",
    "Exchange": "notification-gateway",
    "WakeupQueue": "ng.dispatch.wakeup"
  },
  "Workers": {
    "Enabled": true,
    "BatchSize": 20,
    "Parallelism": 8,
    "PollSeconds": 2,
    "LeaseSeconds": 120
  },
  "OutboundSecurity": {
    "AllowPrivateNetworks": false
  },
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "OpenSeconds": 60
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "AllowedHosts": "*"
}
